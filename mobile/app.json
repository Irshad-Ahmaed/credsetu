{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "scheme": "miniledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a receipt photo to attach to a loan entry.",
          "cameraPermission": "Take a receipt photo to attach to a loan entry.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.miniledger.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.miniledger.app",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
